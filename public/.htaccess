<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Seguridad: Desactivar listado de directorios
  Options -Indexes

  # Si la petición es para un archivo o carpeta existente, servirlo directamente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Para cualquier otra ruta SPA, redirigir a index.html (o 200.html)
  RewriteRule ^ index.html [L]
</IfModule>

# Compresión Gzip / Deflate para optimizar carga en cPanel
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>

# Caché de archivos estáticos (_nuxt)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
