# Puerto de ejecución del frontend Nuxt (por defecto 12001)
PORT=12001
HOST=0.0.0.0

# Conexión al Backend API (Producción: https://baifa-api.batdev.lat/api)
NUXT_PUBLIC_API_BASE=https://baifa-api.batdev.lat/api
NUXT_PUBLIC_AUTH_MODE=api
NUXT_PUBLIC_AUTH_LOGIN_ENDPOINT=/v1/auth/login
NUXT_PUBLIC_AUTH_REGISTER_ENDPOINT=/v1/auth/register
NUXT_PUBLIC_AUTH_ME_ENDPOINT=/v1/auth/me
NUXT_PUBLIC_AUTH_LOGOUT_ENDPOINT=/v1/auth/logout
NUXT_PUBLIC_AUTH_FORGOT_PASSWORD_ENDPOINT=/v1/auth/forgot-password
NUXT_PUBLIC_AUTH_RESET_PASSWORD_ENDPOINT=/v1/auth/reset-password
